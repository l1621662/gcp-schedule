# 复制为 keystore.properties 并填入你自己的签名信息
# （keystore.properties 与 release.jks 都已 gitignore，不会进仓库）

# 生成自己的 release 密钥 —— 在项目根目录执行，会交互式问密码（务必记住并离线备份）：
#   & "$env:USERPROFILE\.jdks\jbr-21.0.11\bin\keytool.exe" -genkeypair -v `
#     -keystore release.jks -alias gcp -keyalg RSA -keysize 4096 -validity 10950 `
#     -storetype PKCS12 -dname "CN=你的名字, OU=GCP-Schedule, O=GCP-Schedule, C=CN"
#
# 注意：
# 1) PKCS12 密钥库里 storePassword 与 keyPassword 用同一个密码；
# 2) 本文件请存成 UTF-8（**无 BOM**）——带 BOM 会让首行键名被污染，签名配置读不到，
#    构建会静默回退 debug 签名（对外分发就废了）；
# 3) release.jks 丢了就无法给已安装用户推送更新，请连同密码一起离线备份。

storeFile=release.jks
storePassword=
keyAlias=gcp
keyPassword=
