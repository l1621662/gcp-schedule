<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 教务导入失败时探测是否经由 VPN/代理出网（学校对代理出口区别对待，见 JwVpnDetector） -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 课表一键同步到系统日历（DESIGN §4.12）：删写本 App 标记事件 + 20 分钟提醒。
         只在用户点「同步到日历」时运行时申请，不预取 -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <!-- 桌面小组件（DESIGN §3.6）：请求忽略电池优化，让后台刷新更及时。
         **可选权限**——用户拒绝后小组件仍可用，只是刷新可能延迟几分钟。
         只在设置页里由用户主动点击申请，不预取、不进首页流程。 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 上课提醒（DESIGN §3.7）：API 33+ 运行时权限，只在用户开启提醒开关那一刻申请 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 重启后闹钟全部丢失：开机广播补排下一个提醒 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 今日页快捷方式（DESIGN §4.16）：API 30+ 包可见性声明。
         三个 package 让预设包可见（getLaunchIntentForPackage 不再对已安装的 App
         误报「未安装」）；MAIN/LAUNCHER 让所有有桌面入口的 App 可见——既是编辑表单
         「从已安装应用选择」的数据源，也让自定义「只填包名」的快捷方式能拉起。
         仍不可见的（无桌面入口的应用）靠执行层 try/catch 兜底。 -->
    <queries>
        <package android:name="com.xunmeng.pinduoduo" />
        <package android:name="com.taobao.taobao" />
        <package android:name="com.cainiao.wireless" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="pinduoduo" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".JuwApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.JuwSchedule"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.JuwSchedule">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- 教务导入独立窗口：adjustResize 保证登录表单不被键盘遮住。
             锁竖屏（DESIGN §4.4）：转屏会销毁 WebView 丢掉登录进度、并取消导入协程；
             全 App 唯一锁方向的窗口。 -->
        <activity
            android:name=".JwImportActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <!-- 设置类二级页统一独立窗口（课表管理/课表设置/显示设置/数据/开水），
             底栏不可达，避免子页与 tab 栈混用 -->
        <activity
            android:name=".SubpageActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 课表小组件（DESIGN §3.6）：**单条目**（2026-09-20 起），尺寸自适应。
             旧的三条目 receiver（Small/Wide/Large）已删——条目名变化会让桌面上
             旧实例失效，用户重新添加一次即可。
             exported=false：系统按 AppWidget 机制拉起，不需要对外暴露。 -->
        <receiver
            android:name=".ui.widget.ScheduleWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

        <!-- 小组件边界闹钟落点（上下课时刻刷新），仅内部广播 -->
        <receiver
            android:name=".ui.widget.WidgetBoundaryReceiver"
            android:exported="false" />

        <!-- 上课提醒（DESIGN §3.7）：边界闹钟落点（显式 PendingIntent，无需 intent-filter）
             与开机补排。两者都只把核对排进 WorkManager，不阻塞主线程。 -->
        <receiver
            android:name=".ui.reminder.ReminderAlarmReceiver"
            android:exported="false" />
        <receiver
            android:name=".ui.reminder.ReminderBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
